# API base URL. Leave empty when using Vite dev server (proxy to backend).
# In production, set to your backend URL, e.g. https://api.example.com
# VITE_API_URL=

# Partner (user) app base URL. Used on Profile to show store signup/referral link for store admins (e.g. https://app.example.com).
# VITE_PARTNER_APP_URL=

# Optional: pin this build to one store (legacy per-store admin build).
# VITE_ADMIN_STORE_CODE=yourstorecode

# Optional: same map as backend ADMIN_HOST_STORE_MAP so the client sends storeCode from hostname.
# Backend Origin mapping is still the source of truth when configured.
# VITE_ADMIN_HOST_STORE_MAP=admin.luckywinnerspower.com:yourstorecode,admin.goodgdragon.com:otherstorecode

# Firebase Cloud Messaging (realtime push). Same web app config as user frontend.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
# Web Push certificate key from Firebase → Project settings → Cloud Messaging
# VITE_FIREBASE_VAPID_KEY=
