# Production env for EC2 — copy to backend/.env on the server and fill secrets.
# Local dev still uses PORT=8080 (see env.sample).

NODE_ENV=production
PORT=8084
APP_NAME=Dragon Fury Backend
TRUST_PROXY=2

USER_BACKEND_URL=https://dragonfury.casino
USER_FRONTEND_URL=https://dragonfury.casino
FRONTEND_URL=https://dragonfury.casino
BACKEND_PUBLIC_URL=https://dragonfury.casino
ALLOWED_ORIGIN=https://dragonfury.casino,https://www.dragonfury.casino,https://admin.dragonfury.casino

ADMIN_HOST_STORE_MAP=admin.dragonfury.casino:dragonfury
PUBLIC_HOST_STORE_MAP=dragonfury.casino:dragonfury,www.dragonfury.casino:dragonfury
# ENFORCE_STORE_ORIGIN_BINDING=true
# ENFORCE_ADMIN_HOST_BINDING=true

# Database
DB_PORT=5432
DB_WRITE_HOST=
DB_READ_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SYNC=false
# DB_SSL=true

JWT_LOGIN_SECRET=
JWT_LOGIN_TOKEN_EXPIRY=24h
JWT_REFRESH_TOKEN_SECRET=
JWT_REFRESH_TOKEN_EXPIRY=30d

EMAIL_FROM=noreply@dragonfury.casino
EMAIL_SENDER_EMAIL=noreply@dragonfury.casino
EMAIL_SENDER_NAME=Dragon Fury
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

DRAGONFURY_FRONTEND_URL=https://dragonfury.casino
DRAGONFURY_MAIL_FROM=no-reply@dragonfury.casino
DRAGONFURY_MAIL_FROM_NAME=DragonFury
