# Database
DB_PORT=5432
DB_WRITE_HOST=localhost
DB_READ_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
# Set DB_SSL=false if your DB does not use SSL
# DB_SSL=false

# App
NODE_ENV=development
PORT=8080
APP_NAME=Dragon Fury Backend
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000
# Behind Cloudflare + nginx, set TRUST_PROXY=2 (or true). Default is 1 (nginx only).
# TRUST_PROXY=1

# Auth (required for login/register)
JWT_LOGIN_SECRET=your-secret-change-in-production
JWT_LOGIN_TOKEN_EXPIRY=24h
JWT_REFRESH_TOKEN_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_TOKEN_EXPIRY=30d

# Google SSO (optional; set GOOGLE_CLIENT_ID to enable)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Facebook SSO (optional; set FACEBOOK_APP_ID and FACEBOOK_APP_SECRET to enable)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Fingerprint Pro — one account per device at signup (DragonFury only)
# FINGERPRINT_SECRET_API_KEY=
# FINGERPRINT_REGION=us
# FINGERPRINT_ENFORCED_STORE_CODES=dragonfury

# Email verification and transactional emails (Mailgun)
FRONTEND_URL=http://localhost:5173
EMAIL_FROM=noreply@partnerplatform.com
# Mailgun: get API key and domain from https://app.mailgun.com/
MAILGUN_API_KEY=your-mailgun-private-api-key
MAILGUN_DOMAIN=mg.yourdomain.com
# Optional: local dev — log admin login OTP to server console instead of Mailgun
# ADMIN_OTP_LOG_ONLY=true
EMAIL_SENDER_EMAIL=noreply@yourdomain.com
EMAIL_SENDER_NAME=Partner Platform

# Email token for verification links (JWT). Set to enable signup email verification.
# EMAIL_TOKEN_KEY=your-secret-key-min-32-chars
# EMAIL_TOKEN_EXPIRY=5d

# Payment (CentryOS / Orionstars Payment API — for deposit/withdraw)
PAYMENT_API_BASE_URL=https://payment-api.orionstarsweeps.com/api
# Optional fallback when the client does not send X-Payment-Partner-Code (e.g. server scripts). Browsers should set VITE_PAYMENT_PARTNER_CODE on the frontend.
# PAYMENT_PARTNER_CODE=PARTNER001
# Set to true or 1 to log all payment API requests/responses in hotpink in the console
# PAYMENT_LOG_ENABLED=true
# Set to true or 1 to log only payment errors in hotpink (useful to debug payment issues)
# PAYMENT_ERROR_LOG_ENABLED=true
# Required for payment: encrypts auto-generated Payment API password (set a long random secret)
# Do NOT define PAYMENT_PASSWORD_ENCRYPTION_KEY twice — with override:true the last value wins and breaks old ciphertext.
# PAYMENT_PASSWORD_ENCRYPTION_KEY=your-32-char-or-longer-secret-key
# Optional: previous key(s), comma-separated, so decrypt still works after a key change
# PAYMENT_PASSWORD_ENCRYPTION_KEY_FALLBACK=previous-key-here
# Optional: same as CentryOS CENTRYOS_WEBHOOK_SECRET — used to verify incoming payment webhooks (COLLECTION/WITHDRAWAL)
# PAYMENT_WEBHOOK_SECRET=your-webhook-secret

# Public URL of THIS backend (used for DollarPay deposit/payout notify_url callbacks).
# Must be your API host — NOT the DollarPay merchant portal.
BACKEND_PUBLIC_URL=https://your-api.example.com
# Legacy alias for BACKEND_PUBLIC_URL. Do NOT set this to mh.dollarpaywallet.com.
# API_PUBLIC_BASE_URL=https://your-api.example.com

# DollarPay (optional override; default is https://mh.dollarpaywallet.com)
# Merchant ID / API key come from store frontend headers (VITE_DOLLARPAY_*), not from this file.
# DOLLARPAY_BASE_URL=https://mh.dollarpaywallet.com

# Speed (crypto) payment provider — optional; set SPEED_API_KEY to enable Speed deposits
# SPEED_API_KEY=sk_live_... or sk_test_...
# SPEED_API_BASE_URL=https://api.tryspeed.com
# SPEED_API_VERSION=2022-10-15
# Optional: verify Speed webhook (checkout_session.paid); use endpoint secret from Speed dashboard
# SPEED_WEBHOOK_SECRET=wsec_...

# Optional: secret for cron routes (e.g. GET /api/cron/subscription-expiring).
# If set, requests must include this secret via ?secret=... or X-Cron-Secret header.
# Leave unset or empty to allow unauthenticated cron calls (e.g. in development).
# CRON_SECRET=

# DragonFury no-deposit email campaigns (marketing). Isolated from transactional MAILGUN_*.
# From: no-reply@dragonfury.com on domain dragonfury.com. No mailbox required — DNS + Mailgun verify only.
# DRAGONFURY_MAILGUN_API_KEY=          # optional; falls back to MAILGUN_API_KEY
# DRAGONFURY_MAILGUN_DOMAIN=dragonfury.com
# DRAGONFURY_MAILGUN_HOST=api.mailgun.net
# DRAGONFURY_MAIL_FROM=no-reply@dragonfury.com
# DRAGONFURY_MAIL_FROM_NAME=DragonFury
# DRAGONFURY_FRONTEND_URL=https://dragonfury.com
# HTTP webhook signing key (Mailgun → API Security) — required for delivery webhooks
# DRAGONFURY_MAILGUN_WEBHOOK_SIGNING_KEY=
# DRAGONFURY_MAIL_BATCH_SIZE=10
# DRAGONFURY_MAIL_MAX_PER_HOUR=40
# DRAGONFURY_MAIL_DELAY_MS=1000
# Enable/test mode are controlled in Admin → Email campaigns (not via env).
# Mailgun webhook: POST /api/webhooks/mailgun/dragonfury-campaigns (failed, delivered, complained)
# Cron: GET /api/cron/dragonfury-no-deposit-campaigns?secret=CRON_SECRET

# Welcome signup bonus — optional production hardening
# When true, register/Google/Facebook signup must send Origin/Referer matching the store's
# userSiteUrl host. Set every store's User site URL in admin BEFORE enabling this.
# Missing userSiteUrl or Origin → 403 on signup. Leave unset/false for local/dev.
# ENFORCE_STORE_ORIGIN_BINDING=false

# Admin multi-domain login — one map for every store admin host (including DragonFury)
# ADMIN_HOST_STORE_MAP=localhost:dragonfury,admin.dragonfury.com:dragonfury,admin.luckywinnerspower.com:goodwork
# Optional: hosts with NO store (master/distributor only). Ignored if host is already in the map above.
# ADMIN_PLATFORM_HOSTS=
# When true, unknown admin hosts are rejected
# ENFORCE_ADMIN_HOST_BINDING=false
# ADMIN_DEFAULT_STORE_CODE=

# GitSlotPark — unsuffixed keys are the fallback for stores without their own suffix.
# Per-store keys: append _{STORE_CODE} uppercased (same pattern as GAMEHUB1_*_{STORE}).
# Example store codes: SWEEPSTAKEBET, CASINOSLOTS, DRAGONFURY, GOODGDRAGON, MYVEPOWER.
# SECRET_KEY must never be in frontend. Agent ID here must match that store's VITE_GIT_SLOTPARK_AGENT_ID.
#
# Optional per-store launch fallback (used if the store frontend does not send headers):
# GIT_SLOTPARK_API_BASE_URL_{STORE}=
# GIT_SLOTPARK_AUTH_TOKEN_{STORE}=
# GIT_SLOTPARK_LOBBY_URL_{STORE}=
# GIT_SLOTPARK_PGSOFT_AUTH_TOKEN_{STORE}=  (and AMATIC_ / AMUSNET_ the same way)

# Pragmatic Play (default provider) — fallback
GIT_SLOTPARK_AGENT_ID=
GIT_SLOTPARK_SECRET_KEY=
# GIT_SLOTPARK_AGENT_ID_SWEEPSTAKEBET=
# GIT_SLOTPARK_SECRET_KEY_SWEEPSTAKEBET=

# PG Soft
GIT_SLOTPARK_PGSOFT_AGENT_ID=
GIT_SLOTPARK_PGSOFT_SECRET_KEY=
# GIT_SLOTPARK_PGSOFT_AGENT_ID_SWEEPSTAKEBET=
# GIT_SLOTPARK_PGSOFT_SECRET_KEY_SWEEPSTAKEBET=

# Amatic
GIT_SLOTPARK_AMATIC_AGENT_ID=
GIT_SLOTPARK_AMATIC_SECRET_KEY=
# GIT_SLOTPARK_AMATIC_AGENT_ID_SWEEPSTAKEBET=
# GIT_SLOTPARK_AMATIC_SECRET_KEY_SWEEPSTAKEBET=

# Amusnet
GIT_SLOTPARK_AMUSNET_AGENT_ID=
GIT_SLOTPARK_AMUSNET_SECRET_KEY=
# GIT_SLOTPARK_AMUSNET_AGENT_ID_SWEEPSTAKEBET=
# GIT_SLOTPARK_AMUSNET_SECRET_KEY_SWEEPSTAKEBET=

# Bona Games (Seamless Wallet V8 — live Bet/Win on platform SC)
# App ID / Secret from Bona; whitelist this server's public IP with Bona.
BONA_API_BASE_URL=https://sg.bona.games
BONA_APP_ID=
BONA_APP_SECRET=
BONA_CURRENCY=SC
# Optional: store lobby URL used as openGame "back" (Base64 on the fly). Defaults to request Origin.
BONA_HOME_URL=
BONA_LANG=en
#
# Give these callback URLs to Bona (must be public HTTPS):
#   POST {YOUR_PUBLIC_API}/api/bona/callback/query
#   POST {YOUR_PUBLIC_API}/api/bona/callback/bet
#   POST {YOUR_PUBLIC_API}/api/bona/callback/settlement
#   POST {YOUR_PUBLIC_API}/api/bona/callback/activity-settlement
#   POST {YOUR_PUBLIC_API}/api/bona/callback/fishing-settlement
# Ask Bona to enable Seamless Wallet (Single Wallet) mode for your App ID.

# 1GameHub (live catalog + seamless SC wallet — no GC)
# PGS URL from 1GameHub (already includes path). Secret + HMAC salt from their dashboard.
GAMEHUB1_BASE_URL=
GAMEHUB1_SECRET_TOKEN=
GAMEHUB1_HMAC_SALT=
#
# Whitelist this callback URL in the 1GameHub dashboard (GAP wallet):
#   POST {BACKEND_PUBLIC_URL}/api/onegamehub/callback
# Example: https://api.yourdomain.com/api/onegamehub/callback

# 568Win operator + Seamless Wallet
# Required for game list: API host, company key, server id (max 15 chars).
# Postman {{BaseUrl}} host only, e.g. https://ex-api-demo-yy.568win.com
WIN568_API_BASE_URL=
# Operator / Seamless Wallet company key from 568Win back office
WIN568_COMPANY_KEY=
# Unique ServerId from their docs (String 15). You choose it; must stay unique.
WIN568_SERVER_ID=dragonfury
# Required later for Register Player (3.1) / launch — agent from API 2.1 (must be a USD agent)
WIN568_AGENT_USERNAME=
# Must match BO Seamless Wallet EnableCurrency (568Win confirmed USD).
WIN568_CURRENCY=USD
#
# Wallet domain in back office 3.3 (WITH trailing slash), not dragonfury.com:
#   {BACKEND_PUBLIC_URL}/api/568win/

# Firebase Cloud Messaging (optional — realtime push for admin + user apps)
# From Firebase Console → Project settings → Service accounts → Generate new private key
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep \n as literal \n in .env (code converts them), or wrap the key in quotes with real newlines
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Direct Crypto Lightning (LND on this same server — see lightning/README.md)
# Use admin.macaroon (invoice.macaroon cannot read balances). Run lightning/scripts/print-lnd-env.sh.
# LND_REST_URL=https://127.0.0.1:18080
# LND_MACAROON_HEX=
# LND_TLS_REJECT_UNAUTHORIZED=false

