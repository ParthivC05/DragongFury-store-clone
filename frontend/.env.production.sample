# Production frontend build env on EC2.
# Leave VITE_API_URL empty so the SPA calls /api on https://dragonfury.casino (nginx → :8084).
# Do not add VITE_*KEY, VITE_*TOKEN, or VITE_*MCH_NO — payment and GitSlotPark
# secrets belong in backend/.env (DOLLARPAY_* / XXPAY_* / GIT_SLOTPARK_*).

VITE_API_URL=
VITE_STORE_CODE=dragonfury
VITE_SITE_TITLE=Dragon Fury
VITE_SITE_ORIGIN=https://dragonfury.casino
VITE_LOGO_URL=/logo.webp
VITE_LOADER_LOGO_URL=/logo.webp
VITE_FAVICON_URL=/logo.webp
VITE_PAYMENT_PARTNER_CODE=goodwork
# VITE_GIT_SLOTPARK_LAUNCH_MODE=iframe
