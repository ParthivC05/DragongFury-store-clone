VITE_LOGO_URL=/logo.webp
VITE_LOADER_LOGO_URL=/logo.webp
VITE_FAVICON_URL=/logo.webp

VITE_GIT_SLOTPARK_LOBBY_URL=https://dragonfury.casino
VITE_GIT_SLOTPARK_PGSOFT_LOBBY_URL=https://dragonfury.casino
VITE_GIT_SLOTPARK_AMATIC_LOBBY_URL=https://dragonfury.casino
VITE_GIT_SLOTPARK_AMUSNET_LOBBY_URL=https://dragonfury.casino
