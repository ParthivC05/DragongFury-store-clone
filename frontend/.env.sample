# Backend API base URL (no trailing slash). Dev proxy uses /api -> localhost:8080
VITE_API_URL=

# Store code for this build (must match store_admin.storeCode in the backend)
VITE_STORE_CODE=dragonfury

# CentryOS / Orionstars Pay partner code for this white-label build (sent as X-Payment-Partner-Code)
VITE_PAYMENT_PARTNER_CODE=goodwork

# XXPay — per-store merchant (frontend env only; sent as request headers)
# VITE_XXPAY_MCH_NO=
# VITE_XXPAY_API_KEY=
# VITE_XXPAY_BASE_URL=https://your-xxpay-gateway.example.com

# SSO (optional). Add these to enable Google / Facebook login. See docs/SSO-SETUP.md.
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# VITE_FACEBOOK_APP_ID=your-facebook-app-id

# Fingerprint Pro — one account per device at signup (DragonFury only)
# VITE_FINGERPRINT_PUBLIC_API_KEY=
# VITE_FINGERPRINT_REGION=us
# VITE_FINGERPRINT_ENFORCE_STORES=dragonfury

# Social links on the guest landing page footer (optional)
# VITE_SOCIAL_FACEBOOK_URL=https://facebook.com/yourpage
# VITE_SOCIAL_TELEGRAM_URL=https://t.me/yourchannel
# VITE_SOCIAL_MESSENGER_URL=https://m.me/yourpage

# Intercom Messenger (support chat) — same as Orionstars: app_id + name/email/user_id from frontend.
# Identity Verification must be OFF in Intercom (Messenger → Security) or logged-in boots get 403.
VITE_INTERCOM_APP_ID=

# GitSlotPark — this store's own keys (never put SECRET_KEY here).
# AGENT_ID must match backend GIT_SLOTPARK_AGENT_ID_{STORE_CODE} (e.g. GIT_SLOTPARK_AGENT_ID_DRAGONFURY).
# Launch mode: iframe (default) or tab (opens provider URL in a new browser tab)
# VITE_GIT_SLOTPARK_LAUNCH_MODE=iframe
# Pragmatic Play (default provider)
VITE_GIT_SLOTPARK_API_BASE_URL=https://apipt.slotgamesapi.com
VITE_GIT_SLOTPARK_AUTH_TOKEN=
VITE_GIT_SLOTPARK_AGENT_ID=
VITE_GIT_SLOTPARK_LOBBY_URL=http://localhost:5173
# PG Soft
VITE_GIT_SLOTPARK_PGSOFT_API_BASE_URL=https://apigg.slotgamesapi.com
VITE_GIT_SLOTPARK_PGSOFT_AUTH_TOKEN=
VITE_GIT_SLOTPARK_PGSOFT_AGENT_ID=
VITE_GIT_SLOTPARK_PGSOFT_LOBBY_URL=http://localhost:5173
# Amatic
VITE_GIT_SLOTPARK_AMATIC_API_BASE_URL=https://api.amaticgame.net
VITE_GIT_SLOTPARK_AMATIC_AUTH_TOKEN=
VITE_GIT_SLOTPARK_AMATIC_AGENT_ID=
VITE_GIT_SLOTPARK_AMATIC_LOBBY_URL=http://localhost:5173
# Amusnet
VITE_GIT_SLOTPARK_AMUSNET_API_BASE_URL=
VITE_GIT_SLOTPARK_AMUSNET_AUTH_TOKEN=
VITE_GIT_SLOTPARK_AMUSNET_AGENT_ID=
VITE_GIT_SLOTPARK_AMUSNET_LOBBY_URL=http://localhost:5173

# Firebase Cloud Messaging (realtime push). Same web app config as admin panel.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
# Web Push certificate key from Firebase → Project settings → Cloud Messaging
# VITE_FIREBASE_VAPID_KEY=

